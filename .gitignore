# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# vite
/dist
vite.config.ts.timestamp-*

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (Supabase URL/anon key van acá, no se comitean)
.env*

# typescript
*.tsbuildinfo

# Claude Code — archivos locales, no compartidos por git
.claude/settings.local.json
CLAUDE.local.md
.claude/worktrees/

# fotos crudas de la clienta (sin curar, no son assets finales)
/fotos-clienta
.gstack/

# contenido para redes (fichas de perfumes, fotos generadas para IG) --
# material de marketing, no pertenece al historial de codigo del sitio
/para-redes

# backup local de fotos PNG originales (2026-08-28, ya preservadas en el
# historial de git de antes de la conversion a webp; no duplicar en el repo)
/assets-originales-fotos-perfumes

# Local Netlify folder
.netlify

# Supabase CLI local cache
/supabase/.temp

# Claude Code — estado local de la skill de brainstorming
/.superpowers

# Claves de solo-lectura de analytics (PostHog/Cloudflare) para que Claude
# consulte trafico sin que Facu entre a los paneles. Nunca se comitean.
.claude/analytics-tokens.local.json

# Historial de snapshots del agente de analytics (scripts/analizar-ag.mjs) --
# estado generado semana a semana, no es codigo fuente.
.claude/analytics-history/
reporte-analytics-*.html
